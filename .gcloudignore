# Pliki pomijane przy wysyłce źródeł do Cloud Build (`gcloud run deploy --source .`).
# Składnia jak .gitignore. Lista musi zgadzać się z .dockerignore.
.gcloudignore
.git
.gitignore
.gitattributes
.claude
/.venv/
.pytest_cache
**/__pycache__
**/*.pyc
/node_modules/
.env

# dane robocze tworzone w czasie działania (ukośnik na początku: tylko w katalogu głównym,
# bo app/data/soilgrids_tiles_pl.json jest potrzebny do działania)
/cache/
/data/

# ML: dane i przebiegi treningowe (setki MB); do działania wystarczą kowr_ml/model i kowr_ml/model_sm
kowr_ml/data/
kowr_ml/runs/

# outputs: do działania potrzebne jest tylko outputs/assety_gleby/webp
outputs/*
!outputs/assety_gleby
outputs/assety_gleby/*
!outputs/assety_gleby/webp

# dokumentacja, testy, transkrypty, skrypty pomocnicze
/docs/
/tests/
/transkrypty_codex/
/scripts/
/start.bat
/deploy.ps1
