{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["frontend/*"] },
    "jsx": "react-jsx",
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["frontend"]
}
