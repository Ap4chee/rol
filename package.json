{
  "name": "kowr-asystent-wody",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild frontend/main.jsx --bundle --minify --target=es2020 --external:/design/* --jsx=automatic --tsconfig=tsconfig.json --outfile=static/ui.js",
